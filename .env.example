# PostgreSQL connection (local, Docker, Neon, Supabase, Render…)
DATABASE_URL=postgresql://wolven:wolven@localhost:5432/wolvenwear

# API port
PORT=4000

# Long random string — used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of sites allowed to call the API (storefront + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://wolvenwear.vercel.app

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@wolvenwear.in
ADMIN_PASSWORD=Wolven@123
ADMIN_NAME=Wolvenwear Admin
